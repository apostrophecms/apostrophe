#!/bin/bash

if [ -z "$TEST_WITH_PRO" ]; then
  echo "Not testing with Pro modules"
  exit 0
fi

echo "Installing dependencies on Pro modules for testing"

# APOS_AUTOMATIC_TRANSLATION_REF picks a branch, tag or commit; the default branch otherwise
pnpm add "git+ssh://git@github.com:apostrophecms/automatic-translation${APOS_AUTOMATIC_TRANSLATION_REF:+#$APOS_AUTOMATIC_TRANSLATION_REF}" || exit 1
