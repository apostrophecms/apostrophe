---
import { widgets } from 'apostrophe-astro-config/doctypes';
import { logError } from '../lib/log.js';

// `editWrapper={false}` leaves out the `data-apos-widget` wrapper of edit
// mode. The render-widget endpoint uses it: the area editor puts that markup
// in a widget component of its own, exactly as it does with the inner HTML of
// the wrapper on a page it loads, and a wrapper left inside it would hide
// fields rendered in place with `AposField` from their editors
const { widget, options, editWrapper = true, ...props } = Astro.props;
const isEdit = widget._edit && Astro.url.searchParams.get("aposEdit");

const key = widget.type;
const componentFound = key in widgets;

let Component;

if (!componentFound) {
  logError(`Missing widget mapping for ${key}`);
} else {
  Component = widgets[key];
}

// Handle anchor functionality using backend options
const hasAnchor = widget?.anchorId;
const anchorsDisabled = options?.anchors === false;
const shouldWrapWithAnchor = hasAnchor && !anchorsDisabled;

// Get anchor attribute from backend options (defaults to 'id')
const anchorAttribute = options?.anchorAttribute || "id";

// Determine wrapper element and attributes
let WrapperElement = "div";
let wrapperAttributes = {};

let StylesWrapperElement = "div";
let stylesElements = options?.aposStylesElements || null;
let stylesAttributes = options?.aposStylesAttributes || {};

if (isEdit && editWrapper) {
  WrapperElement = "div";
  wrapperAttributes["data-apos-widget"] = widget._id;
  // Also add anchor if present to maintain consistent layout
  if (shouldWrapWithAnchor) {
    wrapperAttributes[anchorAttribute] = widget.anchorId;
  }
} else if (shouldWrapWithAnchor) {
  WrapperElement = "div";
  wrapperAttributes[anchorAttribute] = widget.anchorId;
} else {
  WrapperElement = Fragment;
}

if (options?.aposStylesWrapper === false) {
  StylesWrapperElement = Fragment;
  stylesElements = null;
  stylesAttributes = {};
}
---

{
  Component && (
    <WrapperElement {...wrapperAttributes}>
      <Fragment set:html={stylesElements} is:inline />
      <StylesWrapperElement {...stylesAttributes}>
        <Component {widget} {options} {...props} />
      </StylesWrapperElement>
    </WrapperElement>
  )
}
